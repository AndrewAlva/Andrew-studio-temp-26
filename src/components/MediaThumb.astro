---
interface Props {
  src: string;
  type: 'image' | 'video';
  alt: string;
}

const { src, type, alt } = Astro.props;
---

<div class="media-thumb">
  {type === 'image' ? (
    <img src={src} alt={alt} loading="lazy" decoding="async" />
  ) : (
    <video src={src} autoplay muted loop playsinline aria-label={alt} />
  )}
</div>

<style>
  .media-thumb {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--color-surface);
    overflow: hidden;
  }

  .media-thumb img,
  .media-thumb video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms ease-out;
  }

  .media-thumb:hover img,
  .media-thumb:hover video {
    transform: scale(1.03);
  }
</style>
