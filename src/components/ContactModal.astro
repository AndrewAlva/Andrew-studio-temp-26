// TODO: implement ContactModal — native <dialog>, focus trap, Formspree form
---

<dialog
  id="contact-modal"
  role="dialog"
  aria-modal="true"
  aria-labelledby="contact-modal-heading"
>
  <button
    id="contact-close-btn"
    type="button"
    aria-label="Close contact form"
    class="modal-close"
  >
    &times;
  </button>

  <h2 id="contact-modal-heading">Let's work together.</h2>

  <form id="contact-form" novalidate>
    <div class="field">
      <label for="contact-name">Name</label>
      <input id="contact-name" name="name" type="text" required autocomplete="name" />
    </div>
    <div class="field">
      <label for="contact-email">Email</label>
      <input id="contact-email" name="email" type="email" required autocomplete="email" />
    </div>
    <div class="field">
      <label for="contact-message">Message</label>
      <textarea id="contact-message" name="message" required rows="5"></textarea>
    </div>
    <div id="contact-status" role="alert" aria-live="polite"></div>
    <button type="submit">Send</button>
  </form>
</dialog>

