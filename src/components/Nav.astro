---
import { SITE_NAME } from '../config/site';
---

<a class="skip-nav" href="#main-content">Skip to content</a>

<header class="nav-wrapper">
  <nav class="nav" aria-label="Main navigation">
    <a href="/" class="nav-site-name">{SITE_NAME}</a>

    <!-- Clock — absolutely centred so it never shifts the flex edges -->
    <time
      id="nav-clock"
      class="nav-clock"
      datetime=""
      aria-label="Current time in Ciudad de México"
    >
      <span class="clock-time" id="clock-time" aria-hidden="true">--:--:--</span>
      <span class="clock-meta" aria-hidden="true">
        <span id="clock-tz"></span>
        <span class="clock-sep">·</span>
        <span>Ciudad de México</span>
      </span>
    </time>

    <ul class="nav-links" role="list">
      <li><a href="/" class="nav-link">Home</a></li>
      <li><a href="/about" class="nav-link">About</a></li>
      <li>
        <button
          id="contact-open-btn"
          type="button"
          aria-label="Open contact form"
          class="nav-contact-btn"
        >
          Contact
        </button>
      </li>
    </ul>
  </nav>
</header>

<style>
  .nav-wrapper {
    position: absolute;
    top: 0;
    width: 100%;
    z-index: 100;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid rgba(17, 17, 17, 0.06);
  }

  .nav {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--nav-height);
    padding: 0 2rem;
    max-width: 1400px;
    margin: 0 auto;
  }

  .nav-clock {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1px;
    pointer-events: none;
    user-select: none;
    text-decoration: none;
  }

  .clock-time {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .clock-meta {
    display: flex;
    align-items: center;
    gap: 0.3em;
    font-family: var(--font-sans);
    font-size: 9px;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    line-height: 1;
  }

  .clock-sep {
    opacity: 0.4;
  }

  .nav-site-name {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 18px;
    color: var(--color-text);
    text-decoration: none;
    letter-spacing: -0.01em;
    transition: color 300ms ease-out;
  }

  .nav-site-name:hover {
    color: var(--color-text-secondary);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 2rem;
    list-style: none;
  }

  .nav-link {
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--color-text);
    text-decoration: none;
    letter-spacing: 0.01em;
    transition: color 300ms ease-out;
  }

  .nav-link:hover {
    color: var(--color-text-secondary);
  }

  .nav-contact-btn {
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--color-text);
    background: none;
    border: 1px solid currentColor;
    padding: 0.35rem 1rem;
    cursor: pointer;
    letter-spacing: 0.01em;
    transition: background 300ms ease-out, color 300ms ease-out;
  }

  .nav-contact-btn:hover {
    background: var(--color-text);
    color: var(--color-bg);
  }
</style>

<script>
  import { openModal } from '../utils/modal';

  const btn = document.getElementById('contact-open-btn') as HTMLButtonElement | null;
  btn?.addEventListener('click', () => openModal(btn));

  // ── Mexico City clock ────────────────────────────────────────────────────
  const TZ = 'America/Mexico_City';

  const timeFmt = new Intl.DateTimeFormat('en-GB', {
    timeZone: TZ,
    hour: '2-digit',
    minute: '2-digit',
    second: '2-digit',
    hour12: false,
  });

  // Extract the timezone abbreviation at runtime so it follows any future
  // rule changes in the IANA database (Mexico City is UTC-6 / CST since 2023).
  const tzFmt = new Intl.DateTimeFormat('en-US', {
    timeZone: TZ,
    timeZoneName: 'short',
  });

  const timeEl  = document.getElementById('clock-time') as HTMLElement | null;
  const tzEl    = document.getElementById('clock-tz')   as HTMLElement | null;
  const clockEl = document.getElementById('nav-clock')  as HTMLTimeElement | null;

  function tickClock() {
    const now = new Date();
    if (timeEl)  timeEl.textContent  = timeFmt.format(now);
    if (tzEl)    tzEl.textContent    = tzFmt.formatToParts(now).find(p => p.type === 'timeZoneName')?.value ?? 'CST';
    if (clockEl) clockEl.dateTime    = now.toISOString();
  }

  tickClock(); // paint immediately — avoids a one-second flash of "--:--:--"
  setInterval(tickClock, 1000);
</script>
