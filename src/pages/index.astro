---
import Layout from '../layouts/Layout.astro';
import ProjectShowcase from '../components/ProjectShowcase.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order
);
const first = projects[0]?.data;
---

<Layout title="Work" description="Creative portfolio — projects by Andrew Studio.">
  <section class="canvas-section" aria-label="Interactive project viewer">
    <canvas id="glass-canvas" aria-hidden="true" tabindex="-1"></canvas>

    <div class="project-overlay" aria-live="polite" aria-atomic="true">
      <p class="overlay-title" data-project-title>{first?.title ?? ''}</p>
      <p class="overlay-client" data-project-client>{first?.client ?? ''}</p>
      <p class="overlay-meta">
        <span data-project-year>{first?.year ?? ''}</span>
        <span class="overlay-sep" aria-hidden="true">—</span>
        <span data-project-type>{first?.type ?? ''}</span>
      </p>
    </div>
  </section>

  <ProjectShowcase />
</Layout>

<style>
  .canvas-section {
    position: relative;
    width: 100%;
    height: 100svh;
    background: var(--color-surface);
    overflow: hidden;
  }

  #glass-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .project-overlay {
    position: absolute;
    bottom: 2.5rem;
    left: 2.5rem;
    z-index: 10;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .overlay-title {
    font-family: var(--font-serif);
    font-size: clamp(28px, 4vw, 56px);
    font-weight: 400;
    line-height: 1.1;
    color: var(--color-text);
    letter-spacing: -0.02em;
  }

  .overlay-client {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-text-secondary);
  }

  .overlay-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-size: 12px;
    color: var(--color-text-secondary);
  }

  .overlay-sep {
    opacity: 0.35;
  }

  @media (max-width: 640px) {
    .project-overlay {
      bottom: 1.5rem;
      left: 1.25rem;
    }
  }
</style>

<script>
  // TODO: init GlassCarouselScene once that file is implemented
  // The overlay text will be updated by GlassCarouselScene.updateOverlay()
  // which writes to [data-project-title], [data-project-client], etc.
</script>
