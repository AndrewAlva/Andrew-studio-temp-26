---
import Layout from '../layouts/Layout.astro';
import ProjectShowcase from '../components/ProjectShowcase.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order
);
const first  = projects[0]?.data;
// SSR-accurate initial aria-labels: prev = last project, next = second project
const ssrPrev = projects.at(-1)?.data.title ?? '';
const ssrNext = projects[1]?.data.title     ?? '';

// Serialise only the fields the Three.js scene needs
const sceneProjects = projects.map((p) => ({
  title:     p.data.title,
  client:    p.data.client,
  year:      p.data.year,
  type:      p.data.type,
  thumbnail: p.data.thumbnail,
}));
---

<Layout title="Work" description="Creative portfolio — projects by Andrew Studio.">
  <section class="canvas-section" aria-label="Interactive project viewer">
    <canvas id="glass-canvas" aria-hidden="true" tabindex="-1"></canvas>

    <!-- Project data for the Three.js scene (read by client script) -->
    <script id="scene-projects" type="application/json" set:html={JSON.stringify(sceneProjects)} />

    <!-- Metadata overlay — initially server-rendered, then updated by scene -->
    <div class="project-overlay" aria-live="polite" aria-atomic="true">
      <p class="overlay-title"  data-project-title>{first?.title ?? ''}</p>
      <p class="overlay-client" data-project-client>{first?.client ?? ''}</p>
      <p class="overlay-meta">
        <span data-project-year>{first?.year ?? ''}</span>
        <span class="overlay-sep" aria-hidden="true">—</span>
        <span data-project-type>{first?.type ?? ''}</span>
      </p>
    </div>

    <!-- Prev / Next navigation -->
    <nav class="carousel-nav" aria-label="Project navigation">
      <button
        id="project-prev"
        class="carousel-nav__btn"
        type="button"
        aria-label={`Previous project: ${ssrPrev}`}
      >
        <svg aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 18 18" fill="none">
          <path d="M11 4L6 9L11 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <button
        id="project-next"
        class="carousel-nav__btn"
        type="button"
        aria-label={`Next project: ${ssrNext}`}
      >
        <svg aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 18 18" fill="none">
          <path d="M7 4L12 9L7 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </nav>

    <!-- Rotation debug counter (bottom-right) -->
    <div class="rotation-counter" id="rotation-counter" aria-hidden="true">0°</div>
  </section>

  <ProjectShowcase />
</Layout>

<style>
  .canvas-section {
    position: relative;
    width: 100%;
    height: 100svh;
    background: var(--color-surface);
    overflow: hidden;
  }

  #glass-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .project-overlay {
    position: absolute;
    bottom: 2.5rem;
    left: 2.5rem;
    z-index: 10;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    pointer-events: none;
  }

  .overlay-title {
    font-family: var(--font-serif);
    font-size: clamp(28px, 4vw, 56px);
    font-weight: 400;
    line-height: 1.1;
    color: var(--color-text);
    letter-spacing: -0.02em;
  }

  .overlay-client {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-text-secondary);
  }

  .overlay-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-size: 12px;
    color: var(--color-text-secondary);
  }

  .overlay-sep {
    opacity: 0.35;
  }

  .rotation-counter {
    position: absolute;
    bottom: 2.5rem;
    right: 2.5rem;
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--color-text-secondary);
    font-variant-numeric: tabular-nums;
    pointer-events: none;
    user-select: none;
  }

  .carousel-nav {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 1.5rem;
    pointer-events: none; /* let clicks pass through except on the buttons */
    z-index: 10;
  }

  .carousel-nav__btn {
    pointer-events: all;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid rgba(17, 17, 17, 0.18);
    background: rgba(255, 255, 255, 0.55);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: var(--color-text);
    cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
  }

  .carousel-nav__btn:hover {
    background: rgba(255, 255, 255, 0.88);
    border-color: rgba(17, 17, 17, 0.32);
  }

  .carousel-nav__btn:active {
    transform: scale(0.93);
  }

  .carousel-nav__btn:focus-visible {
    outline: 2px solid var(--color-text);
    outline-offset: 3px;
  }

  @media (max-width: 640px) {
    .project-overlay {
      bottom: 1.5rem;
      left: 1.25rem;
    }

    .rotation-counter {
      bottom: 1.5rem;
      right: 1.25rem;
    }

    .carousel-nav {
      padding: 0 0.75rem;
    }
  }
</style>

<script>
  import { GlassCarouselScene } from '../scenes/GlassCarouselScene';
  import { isDebugMode, DebugPanel } from '../utils/debug';

  const init = async () => {
    const canvas  = document.getElementById('glass-canvas') as HTMLCanvasElement | null;
    const dataEl  = document.getElementById('scene-projects');
    if (!canvas || !dataEl) return;

    const projects = JSON.parse(dataEl.textContent ?? '[]');
    const carouselScene = new GlassCarouselScene();
    await carouselScene.init(canvas, projects);

    // ── Prev / Next buttons ────────────────────────────────────────────────
    const prevBtn = document.getElementById('project-prev') as HTMLButtonElement | null;
    const nextBtn = document.getElementById('project-next') as HTMLButtonElement | null;

    const updateNavLabels = (activeIndex: number) => {
      const n = projects.length;
      const prevTitle = projects[(activeIndex - 1 + n) % n]?.title ?? '';
      const nextTitle = projects[(activeIndex + 1) % n]?.title ?? '';
      prevBtn?.setAttribute('aria-label', `Previous project: ${prevTitle}`);
      nextBtn?.setAttribute('aria-label', `Next project: ${nextTitle}`);
    };

    // Sync labels whenever the active project changes
    carouselScene.setProjectChangeCallback(updateNavLabels);
    // Set initial labels (callback won't have been registered during init)
    updateNavLabels(0);

    prevBtn?.addEventListener('click', () => carouselScene.navigate(-1));
    nextBtn?.addEventListener('click', () => carouselScene.navigate(1));

    if (!isDebugMode()) return;

    const renderer = carouselScene.getRenderer();
    if (!renderer) return;

    // ── stats-gl (top-right) ───────────────────────────────────────────────
    const { default: Stats } = await import('stats-gl');
    const stats = new Stats({
      trackGPU: true,
      trackHz: true,
      trackCPT: false,
      logsPerSecond: 20,
      graphsPerSecond: 60,
      samplesLog: 40,
      samplesGraph: 60,
      precision: 2,
      minimal: false,
      horizontal: true,
    });

    // init() patches the Three.js renderer for GPU timer queries — must run
    // before begin()/end() are called in tick, and before DOM insertion so
    // any internal resize listener fires after the element is positioned.
    await stats.init(renderer);

    // Wrap in a fixed positioner so internal style resets can't move it.
    const statsWrap = document.createElement('div');
    Object.assign(statsWrap.style, {
      position: 'fixed',
      top: '0',
      left: '180px',
      zIndex: '9999',
    });
    // stats.dom may have position:fixed;left:0 baked in — neutralise it
    stats.dom.style.position = 'relative';
    stats.dom.style.left = 'auto';
    statsWrap.appendChild(stats.dom);
    document.body.appendChild(statsWrap);

    carouselScene.setStats(stats);

    // ── Custom debug panel (top-left) ──────────────────────────────────────
    // Reads renderer.info after renderer.render() completes (accurate counts),
    // independent of stats-gl so neither inflates the other's numbers.
    const debugPanel = new DebugPanel(renderer, carouselScene.getScene());
    carouselScene.setTickCallback((jsMs) => debugPanel.update(jsMs));
  };

  // Module scripts are deferred; DOMContentLoaded may have already fired
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>
